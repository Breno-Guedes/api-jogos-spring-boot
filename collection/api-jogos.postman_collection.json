
{
  "info": {
    "name": "API de Jogos - IFPI",
    "description": "Collection completa para testar os endpoints da API de Jogos desenvolvida com Spring Boot.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "jogoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET - Consultas",
      "item": [
        {
          "name": "Listar Todos os Jogos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jogos",
              "host": ["{{baseUrl}}"],
              "path": ["jogos"]
            },
            "description": "Retorna todos os jogos cadastrados."
          }
        },
        {
          "name": "Buscar Jogo por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jogos/{{jogoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jogos", "{{jogoId}}"]
            },
            "description": "Busca um jogo específico pelo seu identificador."
          }
        },
        {
          "name": "Listar Jogos em Promoção",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jogos/promocao",
              "host": ["{{baseUrl}}"],
              "path": ["jogos", "promocao"]
            },
            "description": "Retorna apenas os jogos que estão em promoção."
          }
        }
      ]
    },
    {
      "name": "POST - Cadastro",
      "item": [
        {
          "name": "Cadastrar Jogo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"The Witcher 3\",\n  \"plataforma\": \"PC\",\n  \"preco\": 79.90,\n  \"promocao\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/jogos",
              "host": ["{{baseUrl}}"],
              "path": ["jogos"]
            },
            "description": "Cadastra um novo jogo. Retorna HTTP 201 Created."
          }
        }
      ]
    },
    {
      "name": "PUT - Atualização",
      "item": [
        {
          "name": "Atualizar Jogo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"The Witcher 3 Complete Edition\",\n  \"plataforma\": \"PC\",\n  \"preco\": 49.90,\n  \"promocao\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/jogos/{{jogoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jogos", "{{jogoId}}"]
            },
            "description": "Atualiza os dados de um jogo existente pelo ID."
          }
        }
      ]
    },
    {
      "name": "DELETE - Remoção",
      "item": [
        {
          "name": "Apagar Jogo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jogos/{{jogoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jogos", "{{jogoId}}"]
            },
            "description": "Remove um jogo pelo seu identificador."
          }
        }
      ]
    }
  ]
}
